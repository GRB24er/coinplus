# Realtime hub configuration (all server-side — no NEXT_PUBLIC_ keys here)
PORT=8080
HOST=0.0.0.0

# CoinGecko WebSocket endpoint and Pro API key (server-side secret)
COINGECKO_WEBSOCKET_URL=wss://stream.coingecko.com/...
COINGECKO_API_KEY=your-coingecko-pro-key

# Drop a browser socket if it misses two of these ping cycles
CLIENT_HEARTBEAT_INTERVAL_MS=30000
